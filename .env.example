NEO4J_URI=neo4j+s://b919e0ff.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=b919e0ff
AURA_INSTANCENAME=system-one-demo

# NAMS workspace (external mode on the Aura instance above)
MEMORY_API_KEY=
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1
# Admin keys are account-level; the SDK sends this as X-Workspace-Id.
# Must be an ACTIVE workspace (status active in GET /v1/workspace). Switching a workspace to
# external mode or provisioning it needs a dashboard login; an API key gets 403.
MEMORY_WORKSPACE_ID=

# TypeSafe Jev, required; the MCP server refuses to start without it
TYPESAFE_API_KEY=
