# Copy to .env. The Makefile reads it; nothing else does.

# Where the main server (parts 1 to 3) keeps its store: a Relate file on this machine, or Aura.
AIP_DEMO_BACKEND=local            # local | aura

# aura: the Neo4j database behind the main server. Keep credentials out of git (.env is ignored).
# AIP_DEMO_AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# AIP_DEMO_AURA_USER=neo4j
# AIP_DEMO_AURA_PASSWORD=...
# AIP_DEMO_AURA_DATABASE=neo4j

# Ports. The main server is where every client of parts 1 to 3 records; the empty one is part 4's.
AIP_DEMO_MAIN_PORT=8300
AIP_DEMO_EMPTY_PORT=8301
