# Memory database for this demo: any Neo4j 5 with APOC. Local Docker is the quickest:
#   docker run -d --name aip-demo-memory -p 27474:7474 -p 27687:7687 \
#     -e NEO4J_AUTH=neo4j/demopassword -e 'NEO4J_PLUGINS=["apoc"]' neo4j:5
NEO4J_URI=neo4j://localhost:27687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=demopassword
NEO4J_DATABASE=neo4j
# Or an Aura instance (Free is fine); keep it separate from the aip server's catalog database:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_PASSWORD=...

# TypeSafe Jev: the aip client answers decision steps with it (`aip config --decision-model KEY` stores it too)
TYPESAFE_API_KEY=
