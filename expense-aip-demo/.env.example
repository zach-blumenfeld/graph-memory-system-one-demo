# Copy to .env (or copy loan-aip-demo's .env and change the lines below).
# Load it into every shell:   set -a; source .env; set +a

# Keys. Claude answers the LangGraph agent (ANTHROPIC_API_KEY) and `aip agent` (AIP_AGENT_MODEL_KEY).
# `aip agent` is what drives the Studio's chat and its runs. aip's reply cap is 64000 since
# commit f0cf6ec, so claude-sonnet-5-5 answers.
ANTHROPIC_API_KEY=
AIP_AGENT_MODEL_KEY=${ANTHROPIC_API_KEY}
AIP_AGENT_MODEL_NAME=claude-sonnet-5-5
AIP_AGENT_MODEL_URI=https://api.anthropic.com/v1

# This folder's own servers and consoles. The loan demo keeps 8300, 8301 and 4280.
# AIP_SERVER points every `aip`, Claude Code session and agent in this shell at the main one.
# 8311 is part 5's empty server; 4285 is the console for the loan appendix.
AIP_DEMO_MAIN_PORT=8310
AIP_DEMO_EMPTY_PORT=8311
AIP_DEMO_CONSOLE_PORT=4283
AIP_DEMO_CONSOLE_LOAN_PORT=4285
AIP_SERVER=http://127.0.0.1:8310

# The decision model answers each Decide. `aip config --decision-model-key` sets it once per machine.
