Procedure expense_claim_review
  "Review one expense claim against the expense policy: approve it automatically when every rule clearly holds, otherwise a person decides, and record every decided claim in ledger.txt."

  Use_When "An expense claim and its receipt need to be approved or declined under the expense policy."
  Use_When "A claim id such as C-1003 is to be reviewed and its decision recorded in the ledger."
  Do_Not_Use_When "Several claims are to be reviewed at once; run it once per claim."
  Requires python 3.10

Start "The folder holding the claim files and the id of the claim to review." {
  claims_folder: string "The folder holding the claim JSON files and their receipt text files, such as ./claims."
  claim_id: string "The id of the claim to review, such as C-1003."
  Next_Step read_claim
}

Execute read_claim "Read the claim file and the receipt text file it names." {
  Read claims_folder, claim_id
  Run_Script scripts/read_claim.py
  Produce claim: object
          receipt_text: string
          receipt_file: string
          load_problems: string
  Next_Step exact_checks
}

Execute exact_checks "Check item limit, month total, category, receipt present, 30-day window and claimant not the approver." {
  Read claim, receipt_text, receipt_file, load_problems
  Run_Script scripts/exact_checks.py
  Produce exact_ok: true_or_false
          exact_notes: string
  Next_Step load_rules
}

Execute load_rules "Load the list of judgement rules a person would read and judge." {
  Read claim_id
  Run_Script scripts/load_rules.py
  Use assets/judgement_rules.json
  Produce rules: list
  Next_Step each_rule
}

For each_rule Over rules As rule, At_Most 20, Collect verdict Into verdicts {
  Decide judge_rule "Does the claim and its receipt clearly satisfy this judgement rule?" {
    Read rule, claim, receipt_text
    Answer_Questions {
      follows: true_or_false "Judging from the claim and its receipt text alone, does the claim clearly satisfy this rule: {rule}? Answer false if it fails or is doubtful."
    }
    Produce verdict
    Continue
  }

  Next_Step summarize_judgement
}

Aggregate summarize_judgement "Every judgement rule clearly holds, and the model was sure of each." {
  Read verdicts
  Aggregations {
    all_clear: All verdicts.follows With Confidence_Above 0.8
  }
  Produce judgement_summary
  Next_Step combine
}

Execute combine "Combine the exact checks and the judgement verdicts into one answer and a list of issues." {
  Read exact_ok, exact_notes, rules, verdicts, judgement_summary
  Run_Script scripts/combine.py
  Produce auto_ok: true_or_false
          issues: string
  Next_Step by_auto
}

Route by_auto "A claim where every rule clearly holds is approved automatically; anything else goes to a person." {
  Read auto_ok
  true -> auto_approve
  false -> person_decision
}

Execute auto_approve "Approve the claim automatically, with a reason saying all rules hold." {
  Read claim_id, exact_notes
  Run_Script scripts/auto_approve.py
  Produce status: choice [approved, declined]
          reason: string
  Next_Step record_ledger
}

Task_Agent person_decision """A person decides this expense claim, because at least one rule failed or is doubtful. Take it to the person who approves expenses and show them the claim, the receipt text and the rules that failed or are doubtful.

Claim: {claim}

Receipt text: {receipt_text}

Rules that failed or are doubtful: {issues}

The person answers approved or declined and gives a one-line reason. Their decision is final. Answer with exactly these keys: status (approved or declined) and reason (their reason, on one line).""" {
  Read claim, receipt_text, issues
  Produce status: choice [approved, declined]
          reason: string
  Next_Step record_ledger
}

Execute record_ledger "Append one line for the decided claim to ledger.txt." {
  Read claim_id, claim, status
  Run_Script scripts/record_ledger.py
  Produce ledger_line: string
  Next_Step end
}

End "The claim is decided and recorded in the ledger; the status and the reason are the result." {
  Read status, reason
}
