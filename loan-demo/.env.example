# Memory database for this demo (a fresh Aura Free instance; do not reuse aip-demo's)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=loan-demo

# TypeSafe Jev: used by `aip run` locally for decision steps (the aip server reads ~/.config/aip/server.toml too)
TYPESAFE_API_KEY=
