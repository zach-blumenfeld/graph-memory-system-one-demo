# The image for anything that needs aip: building the procedure (bench/build.py) and, later,
# the AIP arm of the benchmark. Claude Code, Python 3.14, the aip wheel built from the local
# checkout, and the aip skill at /opt/aip/skill. No application, no expected outcome, no scorer.
FROM node:22-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code@2.1.328
RUN useradd -m bench
COPY .context/skill /opt/aip/skill
COPY .context/wheels /opt/aip/wheels
USER bench
ENV PATH=/home/bench/.local/bin:$PATH UV_PYTHON_PREFERENCE=only-managed
RUN uv tool install --python 3.14 /opt/aip/wheels/*.whl && aip config server none && aip --version
WORKDIR /work
