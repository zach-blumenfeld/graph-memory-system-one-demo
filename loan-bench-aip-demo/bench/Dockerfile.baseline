# The baseline arm: Claude Code and Python, nothing else. The run's three files are mounted
# read-only at /work; the expected outcomes and the scorer never enter this image.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code@2.1.328
RUN useradd -m bench
USER bench
WORKDIR /work
